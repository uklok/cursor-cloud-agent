{
  "name": "cursor-cloud-agent",
  "version": "0.3.0",
  "private": true,
  "description": "Monorepo for Cursor Cloud coordinator: core lib, OpenClaw plugin, MCP server.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/plugin",
    "packages/mcp"
  ],
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "npm run build -w cursor-cloud-core && npm run build -w cursor-cloud-mcp && npm run build -w openclaw-plugin-cursor-cloud",
    "plugin:build": "npm run plugin:build -w openclaw-plugin-cursor-cloud",
    "plugin:validate": "npm run plugin:validate -w openclaw-plugin-cursor-cloud",
    "test": "vitest run --config ./vitest.config.ts",
    "release": "./scripts/release.sh"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "openclaw": "2026.9.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
