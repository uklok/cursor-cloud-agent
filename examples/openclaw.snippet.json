{
  "plugins": {
    "entries": {
      "cursor-cloud": {
        "enabled": true,
        "config": {
          "defaultEnv": "prod",
          "envs": {
            "prod": {
              "type": "cloud",
              "name": "Production",
              "workdirRule": "SSH clone the target repo to /tmp/<slug> when it is not the environment primary.",
              "skillsPath": "~/.cursor/skills"
            }
          }
        }
      }
    }
  }
}
